# Push update
/common/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, s-maxage=60, max-age=0

# API - JSON endpoints
/co-creation/api/*
  Cache-Control: public, s-maxage=120, max-age=60
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Scripts
/co-creation/scripts/*
  Cache-Control: public, s-maxage=300, max-age=180
  Content-Type: application/x-sh; charset=utf-8
  Access-Control-Allow-Origin: *
